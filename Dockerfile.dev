FROM php:8.4-cli

# Install package yang dibutuhkan
RUN apt-get update && apt-get install -y \
    git \
    unzip \
    zip \
    libzip-dev \
    libpng-dev \
    libjpeg62-turbo-dev \
    libfreetype6-dev \
    libwebp-dev \
    libsqlite3-dev \
    libicu-dev \
    libpq-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install \
        gd \
        pdo_sqlite \
        pdo_mysql \
        pdo_pgsql \
        zip \
        intl \
        bcmath \
        exif \
        pcntl

# Configure PHP ini settings to disable display_errors and hide deprecation warnings
RUN echo "display_errors=Off" > /usr/local/etc/php/conf.d/display-errors.ini \
    && echo "error_reporting=E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED" > /usr/local/etc/php/conf.d/error-reporting.ini

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /app

CMD ["bash"]