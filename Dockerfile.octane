FROM serversideup/php:8.4-frankenphp AS base

USER root

RUN install-php-extensions intl bcmath gd exif pdo_mysql

WORKDIR /var/www/html

FROM base AS vendor

USER www-data

COPY --chown=www-data:www-data composer.json composer.lock ./

RUN composer install --no-dev --no-interaction --no-scripts --optimize-autoloader

FROM oven/bun:1.3.11-alpine AS assets

WORKDIR /app

COPY package.json bun.lock ./

RUN bun install --frozen-lockfile

COPY . ./

RUN bun run build

FROM base AS release

COPY --chown=www-data:www-data . ./
COPY --chown=www-data:www-data --from=vendor /var/www/html/vendor ./vendor
COPY --chown=www-data:www-data --from=assets /app/public/build ./public/build

RUN rm -f bootstrap/cache/*.php \
    && php artisan package:discover --ansi \
    && cp vendor/laravel/octane/src/Commands/stubs/frankenphp-worker.php public/frankenphp-worker.php \
    && mkdir -p storage/app/local storage/app/private/files storage/app/public/media storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && chown -R www-data:www-data storage bootstrap/cache public

ENV APP_BASE_DIR=/var/www/html
ENV PHP_OPCACHE_ENABLE=1
ENV SHOW_WELCOME_MESSAGE=false

STOPSIGNAL SIGINT

USER www-data
